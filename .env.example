# Exelsias Environment Configuration
# ===================================
# Copy this file to .env and fill in your values

# Development mode (set to 'production' for release builds)
NODE_ENV=development

# Optional: Custom data directory (defaults to ./data)
# EXELSIAS_DATA_PATH=/path/to/data

# Optional: Custom models directory (defaults to ./models)
# EXELSIAS_MODELS_PATH=/path/to/models

# Optional: Custom LLM models directory (defaults to ./models/llama)
# EXELSIAS_LLM_MODELS_PATH=/path/to/llama/models
